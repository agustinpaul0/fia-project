# Copiá este archivo a .env (cp .env.example .env) y ajustá los valores si hace falta.
# .env está en .gitignore y un hook bloquea cualquier commit que lo incluya.
# Acá sólo van valores de ejemplo para desarrollo local: jamás credenciales reales.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puertos del host para los contenedores de Postgres (cambialos si ya los usa otro servicio)
DB_PORT=5442
TEST_DB_PORT=5443

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://fia:fia@localhost:5442/fia
BETTER_AUTH_SECRET=development-secret-must-be-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
FIA_ADMIN_EMAIL=admin@fia.com
FIA_ADMIN_PASSWORD=AdminPassword123!
# Contraseña de las cuentas de escudería que crea `pnpm db:seed:demo` (sólo para la demo local)
DEMO_STAFF_PASSWORD=Escuderia2026Demo

# Base exclusiva para tests de integración (contenedor db-test, efímero)
TEST_DATABASE_URL=postgres://fia:fia@localhost:5443/fia_test

# Web (Vite sólo expone al navegador las variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000
