{
  "name": "@fia/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed/run-seed.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@fia/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
}
